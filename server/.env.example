# Puerto del API
PORT=8787

# CORS: origen permitido del frontend (ej. http://localhost:5173). '*' en dev.
CORS_ORIGIN=*

# --- Base de datos ---
# Por defecto es un archivo SQLite LOCAL: no necesitas definir nada para dev.
# Para producción (Turso) completa estas dos — el código NO cambia:
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=...

# Secreto para firmar los JWT. En producción DEFINE uno propio y largo.
AUTH_SECRET=dev-secret-cambiar-en-produccion

# Clave inicial con la que el seeder (db:setup) crea los usuarios.
SEED_ADMIN_PASSWORD=centinela1234

# --- Ingesta por correo (RF-26) ---
# Buzones IMAP a vigilar (JSON). Vacío = canal desactivado.
# En Gmail: activa 2FA y usa una "contraseña de aplicación" como password.
# IMAP_MAILBOXES=[{"host":"imap.gmail.com","user":"monitoreo@gmail.com","password":"xxxx xxxx xxxx xxxx","label":"SENAPRED"}]
IMAP_MAILBOXES=
# Cada cuántos segundos revisar los buzones (por defecto 300 = 5 min).
IMAP_POLL_SECONDS=300

# --- Monitoreo de webs oficiales (RF-20) ---
# Feeds RSS/Atom de sitios oficiales (JSON). Vacío = desactivado.
# WEB_SOURCES=[{"url":"https://www.meteochile.gob.cl/rss/avisos.xml","label":"DMC Avisos","org":"DMC"},{"url":"https://www.senapred.cl/feed/","label":"SENAPRED","org":"SENAPRED"}]
WEB_SOURCES=
# Cada cuántos segundos revisar las webs (por defecto 900 = 15 min).
WEB_POLL_SECONDS=900

# --- Almacenamiento de archivos (evidencias/adjuntos) ---
# Carpeta local por defecto (funciona sin configurar nada).
STORAGE_DIR=./storage
# Cloudflare R2: si defines las 4 variables, se usa R2 en vez de la carpeta local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- IA de apoyo (RF-18) — OPCIONAL. Vacío = APAGADA (US$0, no llama a nada) ---
AI_PROVIDER=
# Opción GRATIS (recomendada): Ollama local. Instala https://ollama.com, corre
# `ollama pull llama3.2`, y pon AI_PROVIDER=ollama. Costo 0.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Opción hosteada (Groq gratis, OpenRouter, etc. — puede tener costo): AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.1-8b-instant
