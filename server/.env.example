# Puerto del API
PORT=8787

# CORS: origen permitido del frontend (ej. http://localhost:5173). '*' en dev.
CORS_ORIGIN=*

# --- Base de datos ---
# Por defecto es un archivo SQLite LOCAL: no necesitas definir nada para dev.
# Para producción (Turso) completa estas dos — el código NO cambia:
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=...

# Secreto para firmar los JWT. En producción DEFINE uno propio y largo.
AUTH_SECRET=dev-secret-cambiar-en-produccion

# Clave inicial con la que el seeder (db:setup) crea los usuarios.
SEED_ADMIN_PASSWORD=centinela1234

# --- Ingesta por correo (RF-26) ---
# Buzones IMAP a vigilar (JSON). Vacío = canal desactivado.
# En Gmail: activa 2FA y usa una "contraseña de aplicación" como password.
# IMAP_MAILBOXES=[{"host":"imap.gmail.com","user":"monitoreo@gmail.com","password":"xxxx xxxx xxxx xxxx","label":"SENAPRED"}]
IMAP_MAILBOXES=
# Cada cuántos segundos revisar los buzones (por defecto 300 = 5 min).
IMAP_POLL_SECONDS=300

# Cloudflare R2 (almacenamiento de evidencias) — etapa posterior
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# IA (RF-18, al final)
ANTHROPIC_API_KEY=
