# Puerto del API
PORT=8787

# CORS: origen permitido del frontend (ej. http://localhost:5173). '*' en dev.
CORS_ORIGIN=*

# Turso (se completa cuando se CREE la BD — etapa final)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth (firma de sesiones/JWT)
AUTH_SECRET=

# Cloudflare R2 (almacenamiento de evidencias)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# IA (RF-18, al final)
ANTHROPIC_API_KEY=
